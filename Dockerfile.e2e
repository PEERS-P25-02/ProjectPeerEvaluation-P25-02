# The runner supplies the exact @playwright/test version from package-lock.json.
# The official image supplies Chromium and its operating-system dependencies.
ARG PLAYWRIGHT_VERSION
FROM mcr.microsoft.com/playwright:v${PLAYWRIGHT_VERSION}-noble

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

COPY playwright.config.cjs ./
COPY tests/e2e ./tests/e2e
CMD ["node", "node_modules/@playwright/test/cli.js", "test"]
