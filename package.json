{
  "name": "peer-evaluation-frontend",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@mui/x-data-grid": "^8.11.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "axios": "^1.4.0",
    "chart.js": "^4.5.1",
    "date-fns": "^4.4.0",
    "formik": "^2.4.9",
    "react": "^19.3.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.0",
    "react-dropzone": "^14.2.3",
    "react-router-dom": "^7.9.0",
    "recharts": "^3.10.1",
    "yup": "^1.7.1"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "start:backend": "npm --prefix src/backend start",
    "start:frontend": "vite",
    "test": "vitest run src/frontend",
    "test:coverage": "vitest run src/frontend --coverage",
    "test:watch": "vitest src/frontend",
    "test:integration": "node src/backend/scripts/runIntegrationTests.js",
    "test:all": "concurrently --names frontend,backend --prefix-colors blue,green \"npm test\" \"npm --prefix src/backend test\"",
    "test:all:coverage": "npm run test:coverage && npm --prefix src/backend run test:coverage",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "setup": "npm install && npm --prefix src/backend install && npm run setup:env",
    "setup:env": "node src/backend/scripts/setupEnv.js",
    "docker:up": "npm run setup:env && docker compose up --build --wait --wait-timeout 120",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs --follow",
    "docker:ps": "docker compose ps",
    "preview": "vite preview",
    "lint": "eslint . && echo Lint passed: no ESLint errors found.",
    "format:check": "prettier --check \"**/*.{js,jsx,mjs,cjs}\"",
    "format": "prettier --write \"**/*.{js,jsx,mjs,cjs}\""
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.27",
    "concurrently": "^10.0.5",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.9",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=9.0.0"
  }
}
