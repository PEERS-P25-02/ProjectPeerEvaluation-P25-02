# Native-local backend: MongoDB and Mailpit ports published on localhost.
# Container backend: use mongodb and mailpit service hostnames instead.
# MONGO_URI is a legacy fallback; prefer MONGODB_URI.
MONGODB_URI=mongodb://localhost:27017/peer-eval

# Required: replace with a unique random secret; setup automation belongs to #22.
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET

# Optional: backend defaults to 5000.
PORT=5000

# Frontend origin used in email links.
FRONTEND_URL=http://localhost:3000

# Local Mailpit: no SMTP authentication and no external email delivery.
SMTP_HOST=localhost
SMTP_PORT=1025
# false for port 587 with STARTTLS; true for implicit TLS on 465.
SMTP_SECURE=false
# Explicit opt-out for local/CI Mailpit; use true for staging.
SMTP_AUTH_REQUIRED=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=peers-test@example.com

# Optional provider preset; overrides SMTP_HOST and SMTP_PORT.
# Leave unset for Mailpit and explicit staging sandbox settings.
# SMTP_SERVICE=gmail
