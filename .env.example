# This file lists settings for running the backend locally or in the Compose stack.
# Run npm run setup:env to create local settings, including the JWT secret.
#
# TLDR: configures MongoDB, the session-signing secret, frontend URL, and SMTP;
# Compose overrides service addresses and captures email in Mailpit.
# Native-local backend: MongoDB and Mailpit ports published on localhost.
# Container backend: use mongodb and mailpit service hostnames instead.
# MONGO_URI is a legacy fallback; prefer MONGODB_URI.
# Submissions require a replica set. directConnection supports the local Compose
# member whose internal hostname is mongodb; use the provider URI for staging.
MONGODB_URI=mongodb://localhost:27017/peer-eval?directConnection=true

# npm run setup:env generates the local JWT secret and reuses it on later runs.
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET

# Optional: backend defaults to 5000.
PORT=5000

# Frontend origin used in email links.
FRONTEND_URL=http://localhost:3000

# Local Mailpit: no SMTP authentication and no external email delivery.
SMTP_HOST=localhost
SMTP_PORT=1025
# false for port 587 with STARTTLS; true for implicit TLS on 465.
SMTP_SECURE=false
# Explicit opt-out for local/CI Mailpit; use true for staging.
SMTP_AUTH_REQUIRED=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=peers-test@example.com

# Optional provider preset; overrides SMTP_HOST and SMTP_PORT.
# Leave unset for Mailpit and explicit staging sandbox settings.
# SMTP_SERVICE=gmail
